<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mithril.UI.ViewModels"
        xmlns:dom="using:Mithril.Domain.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="540"
        Width="780" Height="560"
        MinWidth="680" MinHeight="480"
        x:Class="Mithril.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mithril Vault"
        Background="#0D0D12"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Estilo global de botão primário -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5B6EF5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A5DE4"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A4DD4"/>
        </Style>

        <!-- Estilo de botão secundário -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#C5C5D8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#32324D"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
        </Style>

        <!-- Estilo de botão ícone (com hover de alto contraste) -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25253D"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#5B6EF5"/>
        </Style>

        <!-- TextBox estilizado -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#13131E"/>
            <Setter Property="Foreground" Value="#F0F0FA"/>
            <Setter Property="BorderBrush" Value="#3A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#5B6EF5"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="#5B6EF5"/>
            <Setter Property="Background" Value="#17172A"/>
        </Style>

        <!-- ComboBox estilizado com alto contraste -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#13131E"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#3A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#13131E"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E2E4A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#5B6EF5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- ListBox de Categorias no Topo (Tags horizontais estilo pílulas) -->
        <Style Selector="ListBox.category-tags">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.category-tags ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.category-tags ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.category-tags ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.category-tags ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ListBox sem decoração para a lista principal -->
        <Style Selector="ListBox.main-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TOPBAR                                             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#13131E" Padding="20,14" BorderBrush="#1E1E30" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <!-- Logo e nome -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#5B6EF5" CornerRadius="10" Width="36" Height="36">
                        <TextBlock Text="M" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Mithril Vault" FontSize="15" FontWeight="Bold" Foreground="#E8E8F8"/>
                        <TextBlock Text="Gerenciador de Senhas Seguro" FontSize="10" Foreground="#8E8EAF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badge de status do cofre (centro) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" Padding="12,5"
                        IsVisible="{Binding IsVaultOpen}">
                    <Border.Background>
                        <SolidColorBrush Color="#0F2E1A"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#1A5C30"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1</Thickness>
                    </Border.BorderThickness>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center"/>
                        <TextBlock Text="Cofre Desbloqueado" FontSize="11" Foreground="#4ADE80" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Badge bloqueado -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" Padding="12,5"
                        IsVisible="{Binding !IsVaultOpen}"
                        Background="#1E1510"
                        BorderBrush="#3D2B1A"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center"/>
                        <TextBlock Text="Cofre Bloqueado" FontSize="11" Foreground="#F59E0B" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Switch do Servidor de Rede (SSE) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0"
                            IsVisible="{Binding IsVaultOpen}">
                    <TextBlock Text="Servidor de Rede" FontSize="11" Foreground="#8E8EAF" VerticalAlignment="Center"/>
                    <ToggleSwitch IsChecked="{Binding IsSseServerActive}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Contador de credenciais -->
                <Border Grid.Column="3" CornerRadius="8" Padding="10,5" Background="#1E1E2E"
                        IsVisible="{Binding IsVaultOpen}">
                    <TextBlock FontSize="11" Foreground="#A0A0C5">
                        <Run Text="{Binding Credentials.Count}"/>
                        <Run Text=" credenciais"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- CONTEÚDO PRINCIPAL                                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ───────────────────────────────────────────── -->
            <!-- TELA DE LOGIN                                 -->
            <!-- ───────────────────────────────────────────── -->
            <Grid IsVisible="{Binding !IsVaultOpen}" ColumnDefinitions="*, Auto, *" RowDefinitions="*, Auto, *">
                <Border Grid.Row="1" Grid.Column="1"
                        Width="380"
                        Background="#13131E"
                        BorderBrush="#1E1E30"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="32">
                    <StackPanel Spacing="0">
                        <!-- Ícone -->
                        <Border Background="#1A1A2E" CornerRadius="40" Width="64" Height="64"
                                HorizontalAlignment="Center" Margin="0,0,0,20"
                                BorderBrush="#2A2A50" BorderThickness="1">
                            <TextBlock Text="🛡" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Bem-vindo de volta" FontSize="20" FontWeight="Bold"
                                   Foreground="#E8E8F8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Insira sua Senha Mestre para acessar o cofre" FontSize="12"
                                   Foreground="#8E8EAF" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <TextBlock Text="SENHA MESTRE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#A0A0C5" Margin="0,0,0,6" LetterSpacing="1"/>
                        <TextBox Classes="field"
                                 PasswordChar="●"
                                 Text="{Binding MasterPassword}"
                                 PlaceholderText="Mínimo de 8 caracteres"
                                 Margin="0,0,0,20"/>

                        <Button Classes="primary"
                                Content="Desbloquear Cofre"
                                Command="{Binding OpenOrCreateVaultCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <Border Margin="0,24,0,0" Padding="12" CornerRadius="8"
                                Background="#0D1117" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="AES-256-GCM · PBKDF2 · 600.000 iterações" FontSize="10"
                                           Foreground="#5A7A9A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ───────────────────────────────────────────── -->
            <!-- PAINEL PRINCIPAL DO COFRE                     -->
            <!-- ───────────────────────────────────────────── -->
            <Grid IsVisible="{Binding IsVaultOpen}" RowDefinitions="Auto, Auto, *" Margin="20,16,20,16" RowSpacing="12">

                <!-- Toolbar do painel -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="14" FontWeight="SemiBold" Foreground="#A0A0C0"
                               VerticalAlignment="Center">
                        <Run Text="Credenciais" Foreground="#E8E8F8"/>
                        <Run Text=" &amp; APIs"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="⬇ Backup"
                                Command="{Binding CreateBackupCommand}"
                                IsVisible="{Binding !IsAddFormOpen}"
                                Padding="12,8"/>
                        <Button Classes="primary" Content="+ Nova Credencial"
                                Command="{Binding ToggleAddFormCommand}"
                                IsVisible="{Binding !IsAddFormOpen}"
                                Padding="14,8"/>
                    </StackPanel>
                </Grid>

                <!-- Banner de Notificação Reativa -->
                <Border Grid.Row="1" IsVisible="{Binding IsNotificationOpen}"
                        CornerRadius="8" Padding="14,10"
                        BorderThickness="1">
                    <Border.Styles>
                        <!-- Padrão (Info) -->
                        <Style Selector="Border">
                            <Setter Property="Background" Value="#111A2E"/>
                            <Setter Property="BorderBrush" Value="#3B82F6"/>
                        </Style>
                        <!-- Sucesso -->
                        <Style Selector="Border[Tag=Success]">
                            <Setter Property="Background" Value="#0F2115"/>
                            <Setter Property="BorderBrush" Value="#22C55E"/>
                        </Style>
                        <!-- Erro -->
                        <Style Selector="Border[Tag=Error]">
                            <Setter Property="Background" Value="#2A161A"/>
                            <Setter Property="BorderBrush" Value="#EF4444"/>
                        </Style>
                    </Border.Styles>
                    <Border.Tag>
                        <Binding Path="NotificationType"/>
                    </Border.Tag>
                    
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <!-- Ícone -->
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Info}"/>
                            <TextBlock Text="✅" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Success}"/>
                            <TextBlock Text="❌" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Error}"/>
                        </Panel>

                        <!-- Mensagem -->
                        <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" FontSize="12" 
                                   Foreground="#F0F0FA" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <!-- Botão Fechar -->
                        <Button Grid.Column="2" Classes="icon-btn" Command="{Binding CloseNotificationCommand}" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="11" Foreground="#A0A0C5"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Área central: lista OR formulário -->
                <Grid Grid.Row="2">

                    <!-- LISTA DE CREDENCIAIS (Com Filtro e Busca) -->
                    <Grid IsVisible="{Binding !IsAddFormOpen}" RowDefinitions="Auto, Auto, *">
                        
                        <!-- Barra de Busca (Topo) -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBox Classes="field"
                                     Text="{Binding SearchText}"
                                     PlaceholderText="Buscar por domínio ou usuário..."/>
                        </Grid>

                        <!-- Tags/Categorias Rápidas (Estilo Pills com Seleção Reativa) -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                            <ListBox Classes="category-tags" 
                                     ItemsSource="{Binding FilterCategories}" 
                                     SelectedItem="{Binding SelectedCategoryFilter}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" Padding="12,6" BorderThickness="1" Cursor="Hand" Margin="1,2">
                                            <Border.Styles>
                                                <!-- Estilo Normal das Tags -->
                                                <Style Selector="Border">
                                                    <Setter Property="Background" Value="#13131E"/>
                                                    <Setter Property="BorderBrush" Value="#32324D"/>
                                                </Style>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Background" Value="#25253A"/>
                                                    <Setter Property="BorderBrush" Value="#4A4A6A"/>
                                                </Style>
                                                <!-- Estilo quando Selecionado (Hover de Alto Contraste) -->
                                                <Style Selector="ListBoxItem:selected Border">
                                                    <Setter Property="Background" Value="#5B6EF5"/>
                                                    <Setter Property="BorderBrush" Value="#5B6EF5"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#F0F0FA"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <!-- Listagem física das credenciais -->
                        <Border Grid.Row="2"
                                Background="#0F0F1A"
                                BorderBrush="#1A1A28"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox Classes="main-list" ItemsSource="{Binding FilteredCredentials}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4,3" CornerRadius="10"
                                                    Background="#13131E"
                                                    BorderBrush="#1E1E2E"
                                                    BorderThickness="1"
                                                    Padding="14,12">
                                                <Border.Styles>
                                                    <!-- Hover com Excelente Contraste no Windows -->
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="#1D1D35"/>
                                                        <Setter Property="BorderBrush" Value="#5B6EF5"/>
                                                    </Style>
                                                </Border.Styles>
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <!-- Ícone do tipo -->
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center" Background="#1E2A1E">
                                                        <Panel>
                                                            <TextBlock Text="🌐" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}"/>
                                                            <TextBlock Text="⚡" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Informações com adaptação de nomes (Web: Domínio em destaque, API: Client ID em destaque) -->
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        
                                                        <!-- Linha 1: Título principal do Card e Categoria -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <!-- Se for Web: Exibe Domain -->
                                                            <TextBlock Text="{Binding Domain}" FontSize="14" MaxWidth="280"
                                                                       FontWeight="SemiBold" Foreground="#E0E0F0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}"/>
                                                            <!-- Se for API: Exibe Username (Client ID) no lugar do link/Domain -->
                                                            <TextBlock Text="{Binding Username}" FontSize="14" MaxWidth="280"
                                                                       FontWeight="SemiBold" Foreground="#E0E0F0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"/>
                                                            
                                                            <!-- Badge de Categoria -->
                                                            <Border CornerRadius="6" Padding="6,2" Background="#1E1E38">
                                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#A0A0C5" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Linha 2: Subtítulo do Card e Badges de Criptografia -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <!-- Se for Web: Exibe Username -->
                                                            <TextBlock Text="{Binding Username}" FontSize="12" MaxWidth="220"
                                                                       Foreground="#8E8EAF" TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}"/>
                                                            <!-- Se for API: Exibe Domain (Identificador textual da API) -->
                                                            <TextBlock Text="{Binding Domain}" FontSize="12" MaxWidth="220"
                                                                       Foreground="#8E8EAF" TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"/>
                                                            
                                                            <!-- Badges de Tipo e Segurança -->
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"
                                                                    Background="#0E1830" BorderBrush="#1E3A6A" BorderThickness="1">
                                                                <TextBlock Text="OAuth2 · JWT" FontSize="9" Foreground="#3B82F6" FontWeight="Medium"/>
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Background="#1A0E0E" BorderBrush="#3D1515" BorderThickness="1">
                                                                <TextBlock Text="AES-256" FontSize="9" Foreground="#EF4444" FontWeight="Medium"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Ações de Um Clique -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Copiar Usuário -->
                                                        <Button Classes="icon-btn"
                                                                ToolTip.Tip="Copiar Usuário / Client ID"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyToClipboardCommand}"
                                                                CommandParameter="{Binding Username}">
                                                            <TextBlock Text="👤📋" FontSize="12" Foreground="#8E8EAF"/>
                                                        </Button>
                                                        <!-- Copiar Senha (Apenas para Web) -->
                                                        <Button Classes="icon-btn"
                                                                ToolTip.Tip="Copiar Senha"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyPasswordCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}">
                                                            <TextBlock Text="🔑📋" FontSize="12" Foreground="#8E8EAF"/>
                                                        </Button>
                                                        <!-- Gerar e Copiar Token (Apenas para API) -->
                                                        <Button Classes="icon-btn"
                                                                ToolTip.Tip="Gerar e Copiar Token JWT"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyPasswordCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}">
                                                            <TextBlock Text="⚡📋" FontSize="12" Foreground="#5B6EF5"/>
                                                        </Button>
                                                        <!-- Editar -->
                                                        <Button Classes="icon-btn"
                                                                ToolTip.Tip="Editar"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditCredentialCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="✏" FontSize="13" Foreground="#8E8EAF"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- FORMULÁRIO DE CADASTRO / EDIÇÃO -->
                    <Border IsVisible="{Binding IsAddFormOpen}"
                            Background="#0F0F1A"
                            BorderBrush="#1A1A28"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <!-- Título + voltar -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock IsVisible="{Binding !IsEditing}"
                                                   Text="Nova Credencial" FontSize="16" FontWeight="Bold" Foreground="#E0E0F0"/>
                                        <TextBlock IsVisible="{Binding IsEditing}"
                                                   Text="Editar Credencial" FontSize="16" FontWeight="Bold" Foreground="#E0E0F0"/>
                                        <TextBlock IsVisible="{Binding !IsEditing}"
                                                   Text="Preencha os campos abaixo para adicionar ao cofre" FontSize="11" Foreground="#8E8EAF"/>
                                        <TextBlock IsVisible="{Binding IsEditing}"
                                                   Text="Altere os campos que desejar e salve" FontSize="11" Foreground="#8E8EAF"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon-btn"
                                            Command="{Binding ToggleAddFormCommand}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="✕" FontSize="14" Foreground="#8E8EAF"/>
                                    </Button>
                                </Grid>

                                <!-- Separador -->
                                <Border Height="1" Background="#1A1A28"/>

                                <!-- Tipo de credencial & Categoria -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <!-- Tipo de credencial -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="TIPO" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <RadioButton Content="🌐 Web"
                                                         IsChecked="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}"
                                                         Foreground="#B0B0D0" FontSize="12"/>
                                            <RadioButton Content="⚡ API"
                                                         IsChecked="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"
                                                         Foreground="#B0B0D0" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Categoria -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="CATEGORIA" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding NewCategory}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Campos linha 1 -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="DOMÍNIO / IDENTIFICADOR" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewDomain}"
                                                 PlaceholderText="ex: github.com ou reciprocidade"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="USUÁRIO / CLIENT ID" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewUsername}"
                                                 PlaceholderText="ex: user@email.com"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Campos linha 2 -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="SENHA / CLIENT SECRET" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0" Classes="field"
                                                     Text="{Binding NewPassword}"
                                                     PlaceholderText="Senha ou Client Secret"/>
                                            <Button Grid.Column="1" Content="⚡ Gerar"
                                                    Command="{Binding GeneratePasswordCommand}"
                                                    Background="#1E1E38"
                                                    Foreground="#5B6EF5"
                                                    BorderBrush="#2A2A5A"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    CornerRadius="8"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Gerar senha aleatória forte"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                IsEnabled="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"
                                                Opacity="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}">
                                        <TextBlock Text="URL DO TOKEN (OAUTH2)" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#A0A0C5" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewTokenUrl}"
                                                 PlaceholderText="https://api.server.com/token"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Aviso de API (visível apenas quando ApiToken selecionado) -->
                                <Border CornerRadius="8" Padding="12" Background="#0E1520"
                                        BorderBrush="#1E2D40" BorderThickness="1"
                                        IsVisible="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="O MCP chamará o endpoint de token com Client Credentials (OAuth2) e retornará somente o JWT ao agente de IA."
                                                   FontSize="11" Foreground="#5A7A9A" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de ação -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Classes="secondary" Content="Cancelar"
                                            Command="{Binding ToggleAddFormCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="primary" Content="Salvar no Cofre"
                                            Command="{Binding SaveNewCredentialCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- BARRA DE STATUS                                    -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0D0D12" Padding="20,10"
                BorderBrush="#1A1A28" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#5B6EF5" VerticalAlignment="Center"
                             IsVisible="{Binding IsVaultOpen}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="#7E7E9F" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Background="#0E1020"
                        BorderBrush="#1A2040" BorderThickness="1" IsVisible="{Binding IsVaultOpen}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🤖" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="MCP ativo" FontSize="10" Foreground="#3A4A7A" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
