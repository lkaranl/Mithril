<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mithril.UI.ViewModels"
        xmlns:dom="using:Mithril.Domain.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="540"
        Width="780" Height="560"
        MinWidth="680" MinHeight="480"
        x:Class="Mithril.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mithril Vault"
        Background="#1C1C1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Força o TextBox a manter cores escuras e de alto contraste sob foco e hover no Windows -->
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0A84FF"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#0070E0"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Botão Primário (macOS Blue Accent) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0070E0"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0056B3"/>
        </Style>

        <!-- Botão Secundário -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#98989F"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="BorderBrush" Value="#4A4A4C"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#E5E5EA"/>
        </Style>

        <!-- Botão Danger -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FF453A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3B30"/>
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D82C23"/>
        </Style>

        <!-- Botões de Ação na Sidebar -->
        <Style Selector="Button.sidebar-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#98989F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.sidebar-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
        </Style>

        <!-- Botão de Ícones com Hover de Alto Contraste -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#0A84FF"/>
        </Style>

        <!-- TextBox de Busca Moderno -->
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#0A84FF"/>
        </Style>
        <Style Selector="TextBox.search:focus">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="BorderBrush" Value="#0A84FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox Estilizado para Formulários -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#0A84FF"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="#0A84FF"/>
            <Setter Property="Background" Value="#3A3A3C"/>
        </Style>

        <!-- ComboBox Estilizado -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- ToggleSwitch: Contraste Corrigido para Fundo Escuro -->
        <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#4A4A6A"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#0A84FF"/>
        </Style>
        <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#5A5A80"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#0070E0"/>
        </Style>
        <Style Selector="ToggleSwitch /template/ Border#SwitchKnob">
            <Setter Property="Background" Value="#D0D0E8"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnob">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- ListBox de Categorias na Sidebar -->
        <Style Selector="ListBox.sidebar-categories">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.sidebar-categories ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.sidebar-categories ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.sidebar-categories ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#0A84FF"/>
        </Style>
        <Style Selector="ListBox.sidebar-categories ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ListBox.sidebar-categories ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C2E"/>
        </Style>

        <!-- ListBox sem decoração para a lista principal -->
        <Style Selector="ListBox.main-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.main-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Hover de botões nos Cards -->
        <Style Selector="StackPanel.card-actions">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.card-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Badges Temáticos de Categorias -->
        <Style Selector="Border.category-badge">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.category-badge TextBlock">
            <Setter Property="Foreground" Value="#98989F"/>
        </Style>

        <Style Selector="Border.category-badge[Tag=Produção]">
            <Setter Property="Background" Value="#2A1015"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
        </Style>
        <Style Selector="Border.category-badge[Tag=Produção] TextBlock">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>

        <Style Selector="Border.category-badge[Tag=Homologação]">
            <Setter Property="Background" Value="#2D1F10"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
        <Style Selector="Border.category-badge[Tag=Homologação] TextBlock">
            <Setter Property="Foreground" Value="#F59E0B"/>
        </Style>

        <Style Selector="Border.category-badge[Tag=Trabalho]">
            <Setter Property="Background" Value="#0E1E38"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>
        <Style Selector="Border.category-badge[Tag=Trabalho] TextBlock">
            <Setter Property="Foreground" Value="#3B82F6"/>
        </Style>

        <Style Selector="Border.category-badge[Tag=Pessoal]">
            <Setter Property="Background" Value="#221035"/>
            <Setter Property="BorderBrush" Value="#A855F7"/>
        </Style>
        <Style Selector="Border.category-badge[Tag=Pessoal] TextBlock">
            <Setter Property="Foreground" Value="#A855F7"/>
        </Style>

        <Style Selector="Border.category-badge[Tag=Teste]">
            <Setter Property="Background" Value="#282A10"/>
            <Setter Property="BorderBrush" Value="#EAB308"/>
        </Style>
        <Style Selector="Border.category-badge[Tag=Teste] TextBlock">
            <Setter Property="Foreground" Value="#EAB308"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- ───────────────────────────────────────────── -->
        <!-- TELA DE LOGIN (IsVisible="!IsVaultOpen")       -->
        <!-- ───────────────────────────────────────────── -->
        <Grid IsVisible="{Binding !IsVaultOpen}" Background="#1C1C1E" ColumnDefinitions="*, Auto, *" RowDefinitions="*, Auto, *">
            <Border Grid.Row="1" Grid.Column="1"
                    Width="380"
                    Background="#2C2C2E"
                    BorderBrush="#3A3A3C"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32">
                <StackPanel Spacing="0">
                    <!-- Ícone -->
                    <Border Background="#3A3A3C" CornerRadius="40" Width="64" Height="64"
                            HorizontalAlignment="Center" Margin="0,0,0,20"
                            BorderBrush="#4A4A4C" BorderThickness="1">
                        <TextBlock Text="🛡" FontSize="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Bem-vindo de volta" FontSize="20" FontWeight="Bold"
                               Foreground="#F5F5F7" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Insira sua Senha Mestre para acessar o cofre" FontSize="12"
                               Foreground="#98989F" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                    <TextBlock Text="SENHA MESTRE" FontSize="10" FontWeight="SemiBold"
                               Foreground="#98989F" Margin="0,0,0,6" LetterSpacing="1"/>
                    <TextBox Classes="field"
                             PasswordChar="●"
                             Text="{Binding MasterPassword}"
                             PlaceholderText="Mínimo de 8 caracteres"
                             Margin="0,0,0,20"/>

                    <Button Classes="primary"
                            Content="Desbloquear Cofre"
                            Command="{Binding OpenOrCreateVaultCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <Border Margin="0,24,0,0" Padding="12" CornerRadius="8"
                            Background="#1C1C1E" BorderBrush="#3A3A3C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔒" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="AES-256-GCM · PBKDF2 · 600.000 iterações" FontSize="10"
                                       Foreground="#6C6C70" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ───────────────────────────────────────────── -->
        <!-- LAYOUT DO COFRE DESBLOQUEADO                   -->
        <!-- ───────────────────────────────────────────── -->
        <Grid IsVisible="{Binding IsVaultOpen}" ColumnDefinitions="220, *" RowDefinitions="*, Auto" Background="#1C1C1E">
            
            <!-- 1. SIDEBAR (Col 0, Row 0) -->
            <Border Grid.Column="0" Grid.Row="0" Background="#252528" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="16,20">
                <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto">
                    <!-- Logo / Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,4,12">
                        <Border Background="#0A84FF" CornerRadius="8" Width="30" Height="30">
                            <TextBlock Text="M" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="Mithril Vault" FontSize="14" FontWeight="Bold" Foreground="#F5F5F7"/>
                            <TextBlock Text="Secure Vault" FontSize="9" Foreground="#98989F"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#2A2A2A" Margin="0,0,0,16"/>
                    
                    <!-- Categories ListBox (Vertical Menu) -->
                    <ListBox Grid.Row="2" Classes="sidebar-categories"
                             ItemsSource="{Binding FilterCategories}" 
                             SelectedItem="{Binding SelectedCategoryFilter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="12" Foreground="#0A84FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="#F5F5F7" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Divider -->
                    <Border Grid.Row="3" Height="1" Background="#2A2A2A" Margin="0,16,0,16"/>
                    
                    <!-- System Controls (Backup & Restore) -->
                    <StackPanel Grid.Row="4" Spacing="8" Margin="4,0">
                        <Button Classes="sidebar-action" Content="⬇ Backup do Cofre"
                                Command="{Binding CreateBackupCommand}"
                                IsVisible="{Binding !IsAddFormOpen}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                        <Button Classes="sidebar-action" Content="⬆ Restaurar Backup"
                                Command="{Binding RestoreBackupCommand}"
                                IsVisible="{Binding !IsAddFormOpen}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Grid.Row="5" Height="1" Background="#2A2A2A" Margin="0,16,0,16"/>
                    
                    <!-- Toggles -->
                    <StackPanel Grid.Row="6" Spacing="12" Margin="4,0">
                        <!-- Server toggle -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Servidor Rede" FontSize="11" Foreground="#98989F" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSseServerActive}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Consent toggle -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Consentimento" FontSize="11" Foreground="#98989F" VerticalAlignment="Center"
                                       ToolTip.Tip="Solicitar permissão ao receber chamadas MCP"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsConsentRequired}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Vault Status (Footer) -->
                    <Border Grid.Row="7" Margin="0,20,0,0" Padding="8,6" CornerRadius="6" Background="#2C2C2E">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#32D74B" VerticalAlignment="Center"/>
                            <TextBlock Text="Cofre Desbloqueado" FontSize="10" Foreground="#32D74B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- 2. CONTENT AREA (Col 1, Row 0) -->
            <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto, Auto, *" Margin="20" RowSpacing="12">
                <!-- Search Bar + New Credential button -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#98989F" VerticalAlignment="Center" Margin="12,0,0,0" ZIndex="1"/>
                        <TextBox Grid.Column="0" Grid.ColumnSpan="2" Classes="search"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Buscar por domínio, usuário ou categoria..."
                                 Padding="36,10,12,10"/>
                    </Grid>
                    <Button Grid.Column="1" Classes="primary" Content="+ Nova Credencial"
                            Command="{Binding ToggleAddFormCommand}"
                            IsVisible="{Binding !IsAddFormOpen}"
                            Padding="16,10"/>
                </Grid>
                
                <!-- Notification Banner -->
                <Border Grid.Row="1" IsVisible="{Binding IsNotificationOpen}"
                        CornerRadius="8" Padding="14,10"
                        BorderThickness="1">
                    <Border.Styles>
                        <!-- Padrão (Info) -->
                        <Style Selector="Border">
                            <Setter Property="Background" Value="#1C2C3E"/>
                            <Setter Property="BorderBrush" Value="#0A84FF"/>
                        </Style>
                        <!-- Sucesso -->
                        <Style Selector="Border[Tag=Success]">
                            <Setter Property="Background" Value="#1C2E24"/>
                            <Setter Property="BorderBrush" Value="#32D74B"/>
                        </Style>
                        <!-- Erro -->
                        <Style Selector="Border[Tag=Error]">
                            <Setter Property="Background" Value="#2E1C20"/>
                            <Setter Property="BorderBrush" Value="#FF453A"/>
                        </Style>
                    </Border.Styles>
                    <Border.Tag>
                        <Binding Path="NotificationType"/>
                    </Border.Tag>
                    
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Info}"/>
                            <TextBlock Text="✅" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Success}"/>
                            <TextBlock Text="❌" FontSize="14" IsVisible="{Binding NotificationType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Error}"/>
                        </Panel>

                        <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" FontSize="12" 
                                   Foreground="#F5F5F7" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <Button Grid.Column="2" Classes="icon-btn" Command="{Binding CloseNotificationCommand}" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontSize="11" Foreground="#98989F"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Central Area: List OR Form -->
                <Grid Grid.Row="2">
                    
                    <!-- 2.1 LIST OF CREDENTIALS -->
                    <Grid IsVisible="{Binding !IsAddFormOpen}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox Classes="main-list" ItemsSource="{Binding FilteredCredentials}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" CornerRadius="10"
                                                Background="#2C2C2E"
                                                BorderBrush="#3A3A3C"
                                                BorderThickness="1"
                                                Padding="12,10"
                                                Classes="card">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <!-- Col 0: Domain/Username Initial Avatar -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Center" Background="#1C1C1E" BorderThickness="0">
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="14" FontWeight="Bold" Foreground="#0A84FF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Col 1: Main Info -->
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F7"/>
                                                        <Border Classes="category-badge" CornerRadius="6" Padding="6,2" Tag="{Binding Category}">
                                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Web Credential" FontSize="11" Foreground="#98989F"
                                                                   IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.Web}}"/>
                                                        <TextBlock Text="API Integration" FontSize="11" Foreground="#98989F"
                                                                   IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"/>
                                                        <Border CornerRadius="4" Padding="5,1"
                                                                Background="#1C2E24" BorderBrush="#32D74B" BorderThickness="1">
                                                            <TextBlock Text="AES-256" FontSize="8" Foreground="#32D74B" FontWeight="Medium"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Col 2: Action Buttons (Visible on Hover) -->
                                                <StackPanel Grid.Column="2" Classes="card-actions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- Copiar Senha/Token -->
                                                    <Button Classes="icon-btn"
                                                            ToolTip.Tip="Copiar Senha/Token"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyPasswordCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="📋" FontSize="12" Foreground="#0A84FF"/>
                                                    </Button>
                                                    <!-- Clonar -->
                                                    <Button Classes="icon-btn"
                                                            ToolTip.Tip="Clonar"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloneCredentialCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="📑" FontSize="12" Foreground="#98989F"/>
                                                    </Button>
                                                    <!-- Detalhes -->
                                                    <Button Classes="icon-btn"
                                                            ToolTip.Tip="Mais Detalhes"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowDetailsCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="⋯" FontSize="14" Foreground="#98989F" FontWeight="Bold"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- 2.2 FORM FOR ADD/EDIT -->
                    <Border IsVisible="{Binding IsAddFormOpen}"
                            Background="#2C2C2E"
                            BorderBrush="#3A3A3C"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <!-- Header do formulário -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock IsVisible="{Binding !IsEditing}"
                                                   Text="Nova Credencial" FontSize="16" FontWeight="Bold" Foreground="#F5F5F7"/>
                                        <TextBlock IsVisible="{Binding IsEditing}"
                                                   Text="Editar Credencial" FontSize="16" FontWeight="Bold" Foreground="#F5F5F7"/>
                                        <TextBlock IsVisible="{Binding !IsEditing}"
                                                   Text="Preencha os campos abaixo para adicionar ao cofre" FontSize="11" Foreground="#98989F"/>
                                        <TextBlock IsVisible="{Binding IsEditing}"
                                                   Text="Altere os campos que desejar e salve" FontSize="11" Foreground="#98989F"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="icon-btn"
                                            Command="{Binding ToggleAddFormCommand}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="✕" FontSize="14" Foreground="#98989F"/>
                                    </Button>
                                </Grid>

                                <Border Height="1" Background="#3A3A3C"/>

                                <!-- Tipo de Credencial & Categoria -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <!-- Tipo -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="TIPO" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                            <RadioButton Content="🌐 Web"
                                                         IsChecked="{Binding IsNewCredentialTypeWeb, Mode=TwoWay}"
                                                         Foreground="#F5F5F7" FontSize="12"/>
                                            <RadioButton Content="⚡ API"
                                                         IsChecked="{Binding IsNewCredentialTypeApi, Mode=TwoWay}"
                                                         Foreground="#F5F5F7" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Categoria -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="CATEGORIA" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <ComboBox ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding NewCategory}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Campos Linha 1 -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="DOMÍNIO / IDENTIFICADOR" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewDomain}"
                                                 PlaceholderText="ex: github.com ou reciprocidade"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="USUÁRIO / CLIENT ID" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewUsername}"
                                                 PlaceholderText="ex: user@email.com"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Campos Linha 2 -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="SENHA / CLIENT SECRET" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0" Classes="field"
                                                     Text="{Binding NewPassword}"
                                                     PlaceholderText="Senha ou Client Secret"/>
                                            <Button Grid.Column="1" Content="⚡ Gerar"
                                                    Command="{Binding GeneratePasswordCommand}"
                                                    IsVisible="{Binding IsNewCredentialTypeWeb}"
                                                    Background="#1C1C1E"
                                                    Foreground="#0A84FF"
                                                    BorderBrush="#3A3A3C"
                                                    BorderThickness="1"
                                                    Padding="10"
                                                    CornerRadius="8"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="Gerar senha aleatória forte"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                IsEnabled="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}"
                                                Opacity="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}">
                                        <TextBlock Text="URL DO TOKEN (OAUTH2)" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#98989F" LetterSpacing="1"/>
                                        <TextBox Classes="field"
                                                 Text="{Binding NewTokenUrl}"
                                                 PlaceholderText="https://api.server.com/token"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Info de API Token -->
                                <Border CornerRadius="8" Padding="12" Background="#1C1C1E"
                                        BorderBrush="#3A3A3C" BorderThickness="1"
                                        IsVisible="{Binding NewCredentialType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dom:CredentialType.ApiToken}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="O MCP chamará o endpoint de token com Client Credentials (OAuth2) e retornará somente o JWT ao agente de IA."
                                                   FontSize="11" Foreground="#98989F" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação do Form -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Classes="secondary" Content="Cancelar"
                                            Command="{Binding ToggleAddFormCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="primary" Content="Salvar no Cofre"
                                            Command="{Binding SaveNewCredentialCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            
            <!-- 3. STATUS BAR (Col 0 & 1, Row 1) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1C1C1E" Padding="20,10"
                    BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#0A84FF" VerticalAlignment="Center"
                                 IsVisible="{Binding IsVaultOpen}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                   Foreground="#98989F" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="6" Padding="8,4" Background="#2C2C2E"
                            BorderBrush="#3A3A3C" BorderThickness="1" IsVisible="{Binding IsVaultOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🤖" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="MCP ativo" FontSize="10" Foreground="#98989F" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────────────────────────────────────────── -->
        <!-- OVERLAY: DETALHES DA CREDENCIAL                -->
        <!-- ───────────────────────────────────────────── -->
        <Grid Background="#80000000" IsVisible="{Binding IsDetailsPanelOpen}" ZIndex="100">
            <!-- Modal Container -->
            <Border Width="400" Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Detalhes da Credencial" FontSize="16" FontWeight="Bold" Foreground="#F5F5F7"/>
                        <Button Grid.Column="1" Classes="icon-btn" Command="{Binding CloseDetailsCommand}">
                            <TextBlock Text="✕" FontSize="14" Foreground="#98989F"/>
                        </Button>
                    </Grid>
                    
                    <!-- Divider -->
                    <Border Height="1" Background="#3A3A3C"/>
                    
                    <!-- Credential Details -->
                    <StackPanel Spacing="12">
                        <!-- Tipo -->
                        <Grid ColumnDefinitions="100, *">
                            <TextBlock Grid.Column="0" Text="Tipo" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCredentialForDetails.Type}" FontSize="12" Foreground="#F5F5F7"/>
                        </Grid>
                        
                        <!-- Domínio / Identificador -->
                        <Grid ColumnDefinitions="100, *">
                            <TextBlock Grid.Column="0" Text="Domínio / API" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCredentialForDetails.Domain}" FontSize="12" Foreground="#F5F5F7" TextWrapping="Wrap"/>
                        </Grid>
                        
                        <!-- Categoria -->
                        <Grid ColumnDefinitions="100, *">
                            <TextBlock Grid.Column="0" Text="Categoria" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" Classes="category-badge" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Tag="{Binding SelectedCredentialForDetails.Category}">
                                <TextBlock Text="{Binding SelectedCredentialForDetails.Category}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        
                        <!-- Usuário / Client ID -->
                        <Grid ColumnDefinitions="100, *">
                            <TextBlock Grid.Column="0" Text="Usuário" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedCredentialForDetails.Username}" FontSize="12" Foreground="#F5F5F7" VerticalAlignment="Center"/>
                                <Button Classes="icon-btn" Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialForDetails.Username}">
                                    <TextBlock Text="📋" FontSize="10" Foreground="#0A84FF"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Senha / Secret -->
                        <Grid ColumnDefinitions="100, *">
                            <TextBlock Grid.Column="0" Text="Senha / Secret" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="••••••••" FontSize="12" Foreground="#F5F5F7" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsPasswordDetailsVisible}"/>
                                <TextBlock Text="{Binding DecryptedPasswordForDetails}" FontSize="12" Foreground="#F5F5F7" VerticalAlignment="Center"
                                           IsVisible="{Binding IsPasswordDetailsVisible}"/>
                                
                                <Button Classes="icon-btn" Command="{Binding TogglePasswordDetailsVisibilityCommand}">
                                    <Panel>
                                        <TextBlock Text="👁️" FontSize="12" Foreground="#0A84FF" IsVisible="{Binding !IsPasswordDetailsVisible}"/>
                                        <TextBlock Text="🙈" FontSize="12" Foreground="#0A84FF" IsVisible="{Binding IsPasswordDetailsVisible}"/>
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        
                        <!-- URL do Token (OAuth2) se for API -->
                        <Grid ColumnDefinitions="100, *" IsVisible="{Binding SelectedCredentialForDetails.TokenUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Grid.Column="0" Text="URL do Token" FontSize="11" Foreground="#6C6C70" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCredentialForDetails.TokenUrl}" FontSize="12" Foreground="#F5F5F7" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Border Height="1" Background="#3A3A3C"/>
                    
                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Grid.Column="0" Classes="danger" Content="Excluir"
                                Command="{Binding DeleteCredentialCommand}" CommandParameter="{Binding SelectedCredentialForDetails}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Classes="primary" Content="Editar"
                                Command="{Binding EditCredentialCommand}" CommandParameter="{Binding SelectedCredentialForDetails}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
